---
import { strings, name, langPath, other, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const to = other(lang);
---
<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={`${langPath[lang]}#${t.anchors.home}`}>{name(lang).short}</a>
    <nav class="nav" aria-label={t.nav.label}>
      <a href={`${langPath[lang]}#${t.anchors.specialties}`}>{t.nav.specialties}</a>
      <a href={`${langPath[lang]}#${t.anchors.insurance}`}>{t.nav.insurance}</a>
      <a href={`${langPath[lang]}#${t.anchors.contact}`}>{t.nav.contact}</a>
      <a
        class="lang-pill"
        href={langPath[to]}
        hreflang={to}
        lang={to}
        data-lang-switch
      >{t.nav.switch_short}<span class="sr-only"> · {t.nav.switch_label}</span></a>
    </nav>
  </div>
</header>
